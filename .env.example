# ---------------------------------------------------------------------------
# Configuration. Copy this file to ".env" and edit as needed.
# Every setting has a working default, so .env is optional for local use.
# ---------------------------------------------------------------------------

# --- Security -------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a key is generated and stored in data/.secret_key on first run.
# SECRET_KEY=

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Sign-in throttling.
MAX_LOGIN_ATTEMPTS=6
LOCKOUT_MINUTES=15

# --- Database -------------------------------------------------------------
# Defaults to a SQLite file in data/. For PostgreSQL use, for example:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/reconciliation
# DATABASE_URL=

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=25
# STORAGE_DIR=

# --- Localisation ---------------------------------------------------------
DEFAULT_LOCALE=en          # en or hi
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# --- Reconciliation tuning ------------------------------------------------
# Differences at or below this many paise count as an exact match (100 = Rs 1).
MATCH_TOLERANCE_PAISE=100
# A payment later than this many days past the expected date is "delayed".
DELAY_THRESHOLD_DAYS=7
# Match score (0-100) at or above which an allocation is auto-confirmed.
AUTO_ALLOCATE_SCORE=85
# Below this score nothing is auto-posted; a person decides.
REVIEW_ALLOCATE_SCORE=55

# --- Optional AI narrative layer ---------------------------------------------
# The platform is FULLY FUNCTIONAL without this. Every calculation, match and
# reconciliation is performed by deterministic engines. A provider only lets the
# assistant reword answers that have ALREADY been computed from your data --
# it can never produce or change a financial figure.
#
# Set ONE of the keys below. Free options first:
#
#   Groq        FREE tier, very fast     https://console.groq.com/keys
#   Gemini      FREE tier                https://aistudio.google.com/apikey
#   OpenRouter  FREE models available    https://openrouter.ai/keys
#   Ollama      FREE, fully offline      https://ollama.com  (no key at all)
#   Anthropic   Paid                     https://console.anthropic.com
#
# After setting one, verify it works:   python manage.py testllm

GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Which provider to use: auto | groq | gemini | openrouter | ollama | anthropic | none
# "auto" picks whichever key is set above, preferring the free tiers.
LLM_PROVIDER=auto

# Leave blank to use the provider's sensible default model:
#   groq        openai/gpt-oss-20b
#   gemini      gemini-2.0-flash
#   openrouter  meta-llama/llama-3.3-70b-instruct:free
#   ollama      llama3.2
#   anthropic   claude-sonnet-4-5
LLM_MODEL=

# For fully offline use: install Ollama, run "ollama pull llama3.2",
# then set LLM_PROVIDER=ollama. No key and no internet required.
OLLAMA_HOST=http://localhost:11434

LLM_ENABLED=true
LLM_TIMEOUT=45
LLM_MAX_TOKENS=1600

# --- Runtime --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
WORKER_THREADS=2
